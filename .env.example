# Copy to .env (local only, never committed). Values below are placeholders.
# One file per environment is the recommended pattern: .env.dev, .env.staging, .env.prod (all git-ignored).

# ── Flutter app: PUBLIC values only ──────────────────────────────────────────
# Passed with --dart-define (or --dart-define-from-file=app/dart_defines.<env>.json, see
# app/dart_defines.example.json). The publishable key is safe to ship: Row Level Security is what protects data.
# NEVER put a secret key (sb_secret_...) or the legacy service_role JWT here: the app refuses to start with one.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Backend only (Cloudflare Worker secrets via `wrangler secret put`; NEVER in the repo or the app) ──
SUPABASE_SERVICE_ROLE_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT_EMAIL=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
