# Copy to .env (local only, never committed). Values below are placeholders.
# Flutter app (public by design - the anon key is protected by RLS)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Worker secrets (set with `wrangler secret put`, NEVER in the repo)
SUPABASE_SERVICE_ROLE_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT_EMAIL=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
