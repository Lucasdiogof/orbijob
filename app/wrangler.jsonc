// Copy to the app repo root as wrangler.jsonc. Replace orbijob-web and orbijob.
// Static assets only: no Worker script, so asset requests are free and unlimited
// (https://developers.cloudflare.com/workers/static-assets/billing-and-limitations/).
{
  "name": "orbijob-web",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "assets": {
    "directory": "build/web",
    // Flutter is a SPA: unknown paths fall back to index.html (refresh on /route never 404s).
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "orbijob.lucksrei.com", "custom_domain": true }]
}
