<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (android:dataExtractionRules): same exclusions for cloud backup and for device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
        <exclude domain="root" path="app_webview"/>
        <exclude domain="database" path="webview.db"/>
        <exclude domain="database" path="webviewCookiesChromium.db"/>
        <exclude domain="database" path="webviewCookiesChromiumPrivate.db"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
        <exclude domain="root" path="app_webview"/>
        <exclude domain="database" path="webview.db"/>
        <exclude domain="database" path="webviewCookiesChromium.db"/>
        <exclude domain="database" path="webviewCookiesChromiumPrivate.db"/>
    </device-transfer>
</data-extraction-rules>
